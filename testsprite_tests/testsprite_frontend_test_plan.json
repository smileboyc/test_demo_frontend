[
  {
    "id": "TC001",
    "title": "Successful login redirects to Search page",
    "description": "Verifies a user can log in with valid credentials and is redirected to the protected Search page.",
    "category": "User Login",
    "priority": "High",
    "steps": [
      {
        "type": "action",
        "description": "Navigate to /login"
      },
      {
        "type": "assertion",
        "description": "Verify URL contains \"/login\""
      },
      {
        "type": "action",
        "description": "Type \"{{LOGIN_USER}}\" into the email field"
      },
      {
        "type": "action",
        "description": "Type \"{{LOGIN_PASSWORD}}\" into the password field"
      },
      {
        "type": "action",
        "description": "Click the \"Sign In\" button"
      },
      {
        "type": "assertion",
        "description": "Verify URL contains \"/search\""
      },
      {
        "type": "assertion",
        "description": "Verify text \"Search\" is visible"
      }
    ]
  },
